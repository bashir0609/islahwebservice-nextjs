---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import EnquiryForm from '../components/EnquiryForm';
import ServicePage from '../components/ServicePage.astro';
import OfferPage from '../components/OfferPage.astro';
import { services, industries, enquiryPages, homeFaqs } from '../data/site';
import { serviceDetails } from '../data/page-details';
import { offers } from '../data/offers';
import { listOfflinePublishedPortfolio } from '../content/offline.mjs';

export const prerender = true;

export function getStaticPaths() {
  const offerSlugs = Object.keys(offers);
  return [
    ...services.map(s => s.slug),
    ...enquiryPages.map(p => p.slug),
    ...offerSlugs,
    'services', 'industries', 'about', 'pricing', 'portfolio', 'privacy-policy', 'terms',
  ].map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const service = services.find(item => item.slug === slug);
const serviceDetail = service ? serviceDetails[service.slug] : undefined;
const enquiry = enquiryPages.find(item => item.slug === slug);
const offer = slug ? offers[slug] : undefined;

const titles: Record<string, string> = {
  services: 'The right support starts with the right brief.',
  industries: 'Research with your market in mind.',
  about: 'Useful research. Clear boundaries.',
  pricing: 'Scope first. Price with context.',
  portfolio: 'Published prospect research projects.',
  blog: 'Notes on better prospect research.',
  'privacy-policy': 'Website privacy notice',
  terms: 'Website terms',
};

const title = offer?.metaTitle ?? service?.metaTitle ?? service?.title ?? enquiry?.title ?? titles[slug!];
const descriptions: Record<string, string> = {
  services: 'Compare One-Time Setup, Ongoing Campaign Management and standalone Prospect Research. Six supporting service pages detail scope, deliverables and client responsibilities.',
  industries: 'Explore B2B lead generation and outreach for SaaS, managed service providers, recruitment, professional services and commercial real estate.',
  about: 'Learn how Islah Web Service scopes business research, manages outreach engagements and prepares a practical handoff for your sales team.',
  pricing: 'Three commercial models: One-Time Setup, Ongoing Management and standalone Prospect Research. Pricing is scoped after discovery.',
  portfolio: 'Review published examples of prospect research, contact enrichment, decision-maker research and CRM-ready data delivery.',
  'privacy-policy': 'Website privacy information describing contact handling, enquiry processing and data safeguards for Islah Web Service.',
  terms: 'Website terms covering service boundaries, commercial engagement requirements, compliance responsibilities, and safe use.',
};
const description = offer?.metaDescription ?? service?.metaDescription ?? service?.summary ?? enquiry?.description ?? descriptions[slug!];
const portfolioRecords = slug === 'portfolio' ? await listOfflinePublishedPortfolio() : [];
---
<SiteLayout title={title} description={description}>
{offer ? <OfferPage offer={offer} /> :
service && serviceDetail ? <ServicePage service={service} detail={serviceDetail} services={services} /> :
<div class="container">
  <Breadcrumb items={[{ label: 'Explore' }, { label: enquiry?.title ?? (slug ?? '').replaceAll('-', ' ') }]} />
  <section class="page-hero"><p class="eyebrow">{enquiry ? 'Start a conversation' : 'Islah Web Service'}</p><h1>{enquiry?.title ?? titles[slug!]}</h1><p>{enquiry?.description ?? (slug === 'services' ? 'Three ways to engage: One-Time Setup for teams building their own outbound system, Ongoing Management for recurring research and campaigns, or standalone Prospect Research for teams that handle outreach themselves.' : slug === 'industries' ? 'A useful account list reflects your business context, not just an industry label. Explore our five core markets below.' : slug === 'about' ? 'We help teams turn a clearly defined market into structured, criteria-matched business data. The value is in the fit, the documentation and the handoff.' : slug === 'pricing' ? 'Research is scoped per project. Geography, roles, required fields and verification depth all affect the work involved. Managed service scope and pricing are confirmed through consultation.' : '')}</p></section>
  {enquiry && <div class="content-split">
    <aside>
      <h2>A little context goes a long way.</h2>
      <p>Useful details to include:</p>
      <ul>{enquiry.tips.map(tip => <li>{tip}</li>)}</ul>
      <p class="notice">Submit your enquiry using this secure form or email us at <a href="mailto:hello@islahwebservice.com">hello@islahwebservice.com</a>. We respond within one business day.</p>
      <p class="small">Do not send databases, credentials, financial details or sensitive personal information. No calendar slot is reserved by this page.</p>
    </aside>
    <EnquiryForm client:load kind={enquiry.kind} sourcePage={'/' + slug} />
  </div>}
  {slug === 'services' && <>
    <section class="section compact">
      <div class="offer-paths">
        <p class="eyebrow">THREE ENGAGEMENT MODELS</p>
        <h2>Choose the right way to work together.</h2>
        <p>Start with One-Time Setup to build your outbound system, choose Ongoing Management for recurring research and campaigns, or commission standalone Prospect Research for your own team to use.</p>
      </div>
      <div class="grid three">
        <a href="/one-time-setup" class="offer-card">
          <span class="offer-tag">One-Time Engagement</span>
          <h3>One-Time Outbound Setup</h3>
          <p>Your outbound email system built, configured and handed over. ICP definition, infrastructure, sequences and documentation included.</p>
          <b>Explore One-Time Setup ↗</b>
        </a>
        <a href="/ongoing-management" class="offer-card">
          <span class="offer-tag">Recurring Engagement</span>
          <h3>Ongoing Campaign Management</h3>
          <p>Recurring prospect research, managed campaigns, reply monitoring and monthly performance reporting with continuous optimisation.</p>
          <b>Explore Ongoing Management ↗</b>
        </a>
        <a href="/b2b-prospect-research" class="offer-card">
          <span class="offer-tag">Standalone Service</span>
          <h3>Prospect Research Only</h3>
          <p>Custom B2B prospect lists, decision-maker research and contact enrichment for teams that manage their own outreach.</p>
          <b>Explore Prospect Research ↗</b>
        </a>
      </div>
    </section>
    <section class="section compact">
      <p class="eyebrow">SIX SUPPORTING SERVICES</p>
      <h2>Each service maps to one or more engagement models.</h2>
      <div class="grid two">{services.map(s => <Card title={s.title} summary={s.summary} href={'/' + s.slug} eyebrow={s.category} />)}</div>
    </section>
    <CTA />
  </>}
  {slug === 'industries' && <><section class="section compact"><div class="grid two">{industries.map(i => <Card title={i.title} summary={i.summary} href={'/industries/' + i.slug} />)}</div></section><CTA /></>}
  {slug === 'about' && <>
    <div class="content-split">
      <section>
        <h2>Research as a foundation.<br />A clear scope for what comes next.</h2>
        <p>Islah Web Service helps B2B teams define their target market, research suitable companies and decision-makers, and configure the outbound email systems they need to reach them.</p>
        <p>We work at three levels: One-Time Outbound Setup for teams that want to own their system, Ongoing Campaign Management for businesses that want research and outreach handled month-to-month, and standalone Prospect Research for teams with their own outreach capability.</p>
        <p>In all cases, research begins with your criteria—the companies, markets and roles that matter. We distinguish observable company information from assumptions about need, budget or intent.</p>
      </section>
      <section class="card">
        <p class="eyebrow">OUR WORKING PRINCIPLES</p>
        <h3>Make the limitations visible.</h3>
        <ul>
          <li>Agree required fields, exclusions and research boundaries first.</li>
          <li>Verify business email where available.</li>
          <li>Flag unresolved information rather than invent it.</li>
          <li>Format handoffs for your CRM or workflow.</li>
          <li>Never turn criteria fit into a promise of sales.</li>
          <li>Campaign scope, availability and responsibilities are confirmed in writing before work begins.</li>
        </ul>
      </section>
    </div>
    <section class="section compact">
      <p class="eyebrow">THREE WAYS TO ENGAGE</p>
      <h2>Find the right starting point.</h2>
      <div class="grid three">
        <a href="/one-time-setup" class="offer-card"><span class="offer-tag">Build once</span><h3>One-Time Setup</h3><p>Your outbound system designed, built and handed to your team.</p><b>Learn more ↗</b></a>
        <a href="/ongoing-management" class="offer-card"><span class="offer-tag">Recurring</span><h3>Ongoing Management</h3><p>Research, campaigns and reporting managed on your behalf each month.</p><b>Learn more ↗</b></a>
        <a href="/request-sample" class="offer-card"><span class="offer-tag">Data only</span><h3>Prospect Research</h3><p>Targeted prospect lists and enrichment for your own outreach team.</p><b>Request a sample ↗</b></a>
      </div>
    </section>
    <CTA />
  </>}
  {slug === 'pricing' && <>
    <section class="section compact">
      <div class="pricing-models">
        <p class="eyebrow">THREE COMMERCIAL MODELS</p>
        <h2>Pricing follows the agreed scope.</h2>
        <p>No price is published because market complexity, research volume, infrastructure requirements and campaign scope all affect what the engagement involves. A quote follows a discovery conversation.</p>
      </div>
      <div class="grid three">
        <article class="card pricing-card">
          <p class="eyebrow">ONE-TIME FIXED PROJECT</p>
          <h2>One-Time Outbound Setup</h2>
          <p>Agreed setup deliverables, clearly defined acceptance criteria and a documented handover. Third-party costs are identified separately.</p>
          <ul>
            <li>ICP definition and targeting criteria</li>
            <li>Initial prospect research</li>
            <li>Infrastructure and authentication setup</li>
            <li>Email sequence writing</li>
            <li>Campaign platform configuration</li>
            <li>Handover documentation</li>
          </ul>
          <Button href="/one-time-setup">View Setup Details</Button>
        </article>
        <article class="card pricing-card">
          <p class="eyebrow">MONTHLY MANAGED SERVICE</p>
          <h2>Ongoing Campaign Management</h2>
          <p>Recurring operational scope including research, campaign management and reporting. Change, pause and cancellation terms defined before the engagement begins.</p>
          <ul>
            <li>Recurring prospect research</li>
            <li>Campaign management and deliverability</li>
            <li>Reply monitoring and lead handover</li>
            <li>Weekly updates and monthly reviews</li>
            <li>ICP refinement from campaign data</li>
          </ul>
          <Button href="/ongoing-management">View Management Details</Button>
        </article>
        <article class="card pricing-card">
          <p class="eyebrow">STANDALONE RESEARCH</p>
          <h2>Prospect Research & Enrichment</h2>
          <p>Fixed project or recurring data delivery. Priced by scope, record count and research complexity.</p>
          <ul>
            <li>Target-account and role criteria</li>
            <li>Custom prospect research</li>
            <li>Agreed fields and verification notes</li>
            <li>Structured data handoff</li>
            <li>Existing database enrichment</li>
          </ul>
          <Button href="/request-sample">Request a Sample</Button>
        </article>
      </div>
      <p class="notice">Third-party software, domains and mailboxes are excluded unless expressly incorporated into the written contract. Managed package scope and availability are confirmed through consultation and written terms.</p>
    </section>
    <section class="section compact">
      <div class="content-split">
        <section>
          <p class="eyebrow">WHAT AFFECTS PRICING</p>
          <h2>A quote follows the brief.</h2>
          <p>There is no published fixed price. Before agreeing a project, the scope, expectations, delivery format and commercial terms must be defined. The following factors affect the engagement cost:</p>
          <ul>
            <li>Target market, geography and audience complexity</li>
            <li>Number of market segments and ICP variations</li>
            <li>Research volume and required data fields</li>
            <li>Verification and source-documentation requirements</li>
            <li>Infrastructure requirements and third-party tools</li>
            <li>Campaign capacity and sending volume</li>
            <li>Reply and appointment-coordination responsibilities</li>
            <li>CRM integration and reporting scope</li>
            <li>Delivery schedule and review frequency</li>
          </ul>
          <p class="small">Third-party costs for domain registrars, email providers, campaign platforms and data tools are always identified separately and are the client's responsibility unless incorporated into the written contract.</p>
        </section>
        <section class="card">
          <p class="eyebrow">SIX PROJECT-FIT CRITERIA</p>
          <h3>What we assess before confirming a scope.</h3>
          <ul>
            <li>Clear client offer and business objective.</li>
            <li>Identifiable and sufficiently targetable market.</li>
            <li>Research and contact-data feasibility.</li>
            <li>Legal eligibility for the proposed outreach.</li>
            <li>Available sales follow-up and handoff ownership.</li>
            <li>Agreed commercial scope, deliverables and acceptance criteria.</li>
          </ul>
          <p class="small">These are project assessment criteria, not arbitrary public eligibility barriers.</p>
          <Button href="/request-sample">Request a Research Sample</Button>
        </section>
      </div>
    </section>
    <FAQ items={homeFaqs.slice(0, 3)} />
    <div class="section"><CTA /></div>
  </>}
  {slug === 'portfolio' && <section class="section compact"><div class="section-heading"><div><p class="eyebrow">EXISTING PUBLIC CASE STUDIES</p><h2>Published project examples preserved from the current website.</h2></div><p>These pages retain the original public content and dates. Project-specific details are not promises of future outcomes.</p></div><div class="grid three">{portfolioRecords.map(record => <article class="card blog-card"><p class="eyebrow">{record.tags.slice(0,2).join(' · ')}</p><h3><a href={`/portfolio/${record.slug}`}>{record.title}</a></h3><p>{record.seo.description}</p>{record.publishedAt && <p class="blog-meta"><time datetime={record.publishedAt}>{record.publishedAt}</time></p>}<a class="text-link" href={`/portfolio/${record.slug}`}>Read case study ↗</a></article>)}</div></section>}
  {slug === 'privacy-policy' && <article class="prose"><h2>Privacy Notice</h2><p>Islah Web Service respects your privacy and is committed to protecting business and personal data. This privacy notice explains how we collect and process information when you use our website or submit an enquiry.</p><h2>Enquiry and contact handling</h2><p>When you submit an enquiry through our website forms or by email to <a href="mailto:hello@islahwebservice.com">hello@islahwebservice.com</a>, we collect your name, work email address, company name, and project requirements solely to respond to your enquiry, assess project feasibility, and provide quotation details. We do not sell your personal data, rent contact lists, or use enquiry details for unrelated third-party marketing.</p><h2>Safe use and data submission</h2><p>Do not submit confidential client databases, financial credentials, or sensitive personal data through our website forms. Dedicated secure file transfer channels are arranged only after a formal engagement scope and data-processing agreement are confirmed.</p><h2>Website operations and technical logs</h2><p>Our website hosting infrastructure processes standard HTTP request logs (including IP address, browser user-agent, and access timestamps) for security monitoring, abuse prevention, and rate-limiting purposes.</p><h2>Your rights</h2><p>You may request access to, correction of, or deletion of your enquiry data at any time by contacting <a href="mailto:hello@islahwebservice.com">hello@islahwebservice.com</a>.</p></article>}
  {slug === 'terms' && <article class="prose"><h2>Website Terms of Service</h2><p>This website provides service information, technical guidance, and an enquiry channel for Islah Web Service. Submitting an enquiry does not create a binding service contract, reserve calendar time, or guarantee project acceptance.</p><h2>Commercial engagements</h2><p>All client engagements—including One-Time Outbound Setup, Ongoing Campaign Management, and Standalone Prospect Research—are governed by a separately executed written agreement detailing scope, deliverables, acceptance criteria, commercial fees, and third-party software responsibilities.</p><h2>Service boundaries &amp; performance</h2><p>Criteria-matched prospect research documents observable company and role information against agreed parameters; it does not constitute active buyer intent or guaranteed purchasing authority. Email verification reduces bounce risk but does not guarantee 100% inbox deliverability, open rates, replies, meetings, or revenue.</p><h2>Client responsibilities</h2><p>Clients are solely responsible for verifying the legal eligibility of outbound campaigns within their target jurisdictions (including compliance with GDPR, PECR, and CAN-SPAM regulations), reviewing message copy prior to sending, and maintaining suppression lists.</p><h2>Safe use</h2><p>Do not transmit credentials, passwords, or confidential customer databases through website contact forms. All secure data transfers must be pre-arranged under written agreement.</p></article>}
</div>}
</SiteLayout>

<style>
  .offer-paths { max-width: 760px; margin-bottom: 36px; }
  .offer-paths h2 { font-size: clamp(30px,3.5vw,46px); }
  .offer-card { display: block; padding: 28px; border: 1px solid #dfe2df; border-radius: 14px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .offer-card:hover { transform: translateY(-2px); box-shadow: 0 14px 30px #1111; }
  .offer-tag { display: inline-block; margin-bottom: 14px; padding: 4px 10px; border-radius: 6px; background: #fff5f1; color: #a72b09; font-size: 10px; font-weight: 750; letter-spacing: .08em; border: 1px solid #ffd0c0; }
  .offer-card h3 { margin: 0 0 10px; font-size: 20px; }
  .offer-card p { margin: 0 0 18px; color: #555; font-size: 14px; }
  .offer-card b { font-size: 12px; color: #a72b09; }
  .grid.three { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
  .pricing-models { max-width: 760px; margin-bottom: 36px; }
  .pricing-models h2 { font-size: clamp(30px,3.5vw,46px); }
  .pricing-card h2 { font-size: 24px; }
  .pricing-card ul { padding-left: 18px; color: #444; font-size: 13px; line-height: 1.9; margin-bottom: 20px; }
  @media (max-width:900px) { .grid.three { grid-template-columns: 1fr 1fr; } }
  @media (max-width:680px) { .grid.three { grid-template-columns: 1fr; } }
</style>
