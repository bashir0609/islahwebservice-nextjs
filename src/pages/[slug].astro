---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import EnquiryForm from '../components/EnquiryForm';
import ContactChannel from '../components/ContactChannel.astro';
import ServicePage from '../components/ServicePage.astro';
import { packages } from '../data/packages';
import { services, industries, enquiryPages, homeFaqs } from '../data/site';
import { serviceDetails } from '../data/page-details';
import { listOfflinePublishedPortfolio } from '../content/offline.mjs';
export const prerender = true;
export function getStaticPaths() {
  return [...services.map(s => s.slug), ...enquiryPages.map(p => p.slug), 'services', 'industries', 'about', 'pricing', 'portfolio', 'privacy-policy', 'terms'].map(slug => ({ params: { slug } }));
}
const { slug } = Astro.params;
const service = services.find(item => item.slug === slug);
const serviceDetail = service ? serviceDetails[service.slug] : undefined;
const enquiry = enquiryPages.find(item => item.slug === slug);
const titles: Record<string, string> = { services: 'The right support starts with the right brief.', industries: 'Research with your market in mind.', about: 'Useful research. Clear boundaries.', pricing: 'Scope first. Price with context.', portfolio: 'Published prospect research projects.', blog: 'Notes on better prospect research.', 'privacy-policy': 'Website privacy notice', terms: 'Website terms' };
const title = service?.title ?? enquiry?.title ?? titles[slug!];
const descriptions: Record<string, string> = {
  services: 'Choose standalone prospect research or discuss managed outreach scope and availability. Compare contact enrichment, infrastructure and campaign support scopes.',
  industries: 'Explore prospect research for SaaS, managed service providers, recruitment, professional services and property businesses.',
  about: 'Learn how Islah Web Service scopes business research, documents limitations and prepares a practical handoff for your sales team.',
  pricing: 'Compare flexible engagement options for prospect research and managed outreach. Request a scoped quote based on your brief.',
  portfolio: 'Review existing published examples of prospect research, contact enrichment, decision-maker research and CRM-ready data delivery.',
  'privacy-policy': 'Website privacy information describing current contact handling and the safeguards required before collecting enquiries through online forms.',
  terms: 'Website terms covering service boundaries, safe use and the requirement for a separately agreed engagement.',
};
const description = service?.summary ?? enquiry?.description ?? descriptions[slug!];
const localFormEnabled = import.meta.env.DEV;
const portfolioRecords = slug === 'portfolio' ? await listOfflinePublishedPortfolio() : [];
---
<SiteLayout title={title} description={description}>
{service && serviceDetail ? <ServicePage service={service} detail={serviceDetail} services={services} /> : <div class="container">
  <Breadcrumb items={[{ label: 'Explore' }, { label: enquiry?.title ?? (slug ?? '').replaceAll('-', ' ') }]} />
  <section class="page-hero"><p class="eyebrow">{enquiry ? 'Start a conversation' : 'Islah Web Service'}</p><h1>{enquiry?.title ?? titles[slug!]}</h1><p>{enquiry?.description ?? (slug === 'services' ? 'Choose standalone prospect research and enrichment, or discuss an integrated managed outreach scope. Research remains independently available.' : slug === 'industries' ? 'A useful account list reflects your business context, not just an industry label. Start with one of our five core markets.' : slug === 'about' ? 'We help teams turn a clearly defined market into structured, criteria-matched business data. The value is in the fit, the documentation and the handoff.' : slug === 'pricing' ? 'Research is scoped per project. Geography, roles, required fields and verification depth all affect the work involved.' : '')}</p></section>
  {enquiry && <div class="content-split"><aside><h2>A little context goes a long way.</h2><p>Useful details to include:</p><ul>{enquiry.tips.map(tip => <li>{tip}</li>)}</ul><p class="notice">Online form processing is not currently available. Please use the verified email contact shown here.</p><p class="small">Do not send databases, credentials, financial details or sensitive personal information. No calendar slot is reserved by this page.</p></aside>{localFormEnabled ? <EnquiryForm client:load kind={enquiry.kind} /> : <ContactChannel context={enquiry.kind === 'research' ? 'research' : enquiry.kind === 'consultation' ? 'consultation' : 'contact'} />}</div>}
  {slug === 'services' && <><section class="section compact"><div class="grid two">{services.filter(s => !s.pending).map(s => <Card title={s.title} summary={s.summary} href={'/' + s.slug} eyebrow={s.category} />)}</div></section><section class="section compact"><p class="eyebrow">Managed outreach consultations</p><h2>Discuss scope and current availability.</h2><p class="notice">The journeys below explain managed-service options that can be discussed through consultation. Scope, availability and responsibilities are confirmed before an engagement begins. This website does not launch campaigns, send email or book appointments, and research remains a separate service.</p><div class="grid two">{services.filter(s => s.pending).map(s => <Card title={s.title} summary={s.summary} href={'/' + s.slug} pending />)}</div></section><CTA /></>}
  {slug === 'industries' && <><section class="section compact"><div class="grid two">{industries.map(i => <Card title={i.title} summary={i.summary} href={'/industries/' + i.slug} />)}</div></section><CTA /></>}
  {slug === 'about' && <><div class="content-split"><section><h2>Research as a foundation.<br />A clear scope for what comes next.</h2><p>Research begins with your criteria: the companies, markets and roles that matter to your business. We distinguish observable company information from assumptions about need, budget or buying intent.</p><p>When you already have records, enrichment is a separate starting point. The goal is to fill agreed gaps and improve consistency, rather than quietly replace your database.</p></section><section class="card"><p class="eyebrow">Our working principles</p><h3>Make the limitations visible.</h3><ul><li>Agree the required fields and exclusions.</li><li>Verify business email where available.</li><li>Flag unresolved information rather than invent it.</li><li>Format the handoff for your team’s workflow.</li><li>Never turn criteria fit into a promise of sales.</li></ul></section></div><CTA /></>}
  {slug === 'pricing' && <><section class="section compact"><div class="grid two">{packages.map(pkg => <article class="card"><p class="eyebrow">{pkg.status}</p><h2>{pkg.name}</h2><p>{pkg.description}</p><h3>Custom Pricing</h3><ul>{pkg.includes.map(item => <li>{item}</li>)}</ul><Button href="/free-consultation">Request a Quote</Button></article>)}</div><p class="notice">Third-party software, domains and mailboxes are excluded unless expressly incorporated into the written contract. Managed package scope and availability are confirmed through consultation and written terms.</p></section><div class="content-split"><section><h2>A quote follows the brief.</h2><p>There is no published fixed price. Before agreeing a project, define the scope, review expectations, delivery format and commercial terms.</p><ul><li>New research or existing database enrichment</li><li>Markets, company criteria and target roles</li><li>Record volume and required fields</li><li>Verification and source-documentation requirements</li><li>Delivery schedule and review process</li></ul></section><section class="card"><p class="eyebrow">Bring a starting point</p><h3>Not sure what to ask for?</h3><p>Describe your current data and the gap you need to close. A sample brief helps make the discussion specific.</p><Button href="/request-sample">Request a research sample</Button></section></div><FAQ items={homeFaqs.slice(0, 3)} /><div class="section"><CTA /></div></>}
  {slug === 'portfolio' && <section class="section compact"><div class="section-heading"><div><p class="eyebrow">EXISTING PUBLIC CASE STUDIES</p><h2>Published project examples preserved from the current website.</h2></div><p>These pages retain the original public content and dates. Project-specific details are not promises of future outcomes.</p></div><div class="grid three">{portfolioRecords.map(record => <article class="card blog-card"><p class="eyebrow">{record.tags.slice(0,2).join(' · ')}</p><h3><a href={`/portfolio/${record.slug}`}>{record.title}</a></h3><p>{record.seo.description}</p>{record.publishedAt && <p class="blog-meta"><time datetime={record.publishedAt}>{record.publishedAt}</time></p>}<a class="text-link" href={`/portfolio/${record.slug}`}>Read case study ↗</a></article>)}</div></section>}
  {slug === 'privacy-policy' && <article class="prose"><p class="notice">This notice requires professional legal review before online enquiry collection is enabled.</p><h2>Current contact handling</h2><p>Online forms are not enabled. If you contact Islah Web Service by email, do not include sensitive information, credentials or confidential databases.</p><h2>Website operations</h2><p>Hosting infrastructure may process requests and technical logs. The applicable processors, storage locations, retention periods and access controls must be documented before online enquiry processing is enabled.</p><h2>Your choice</h2><p>You can choose not to make contact. The website does not currently connect visitor enquiries to a CRM, notification-delivery service or campaign-sending workflow.</p><h2>Legal review required</h2><p>Controller contact details, rights-request procedures and any international transfers require professional review. Do not use this website to submit a rights request or confidential records.</p></article>}
  {slug === 'terms' && <article class="prose"><p class="notice">Draft website terms requiring owner and professional legal review before production publication.</p><h2>A demonstration, not an agreement</h2><p>This website provides service information and an email contact channel. An enquiry does not confirm delivery, a quotation, a consultation booking or acceptance of work. No service contract is created here.</p><h2>Service boundaries</h2><p>Prospect research and existing database enrichment are distinct services. Managed service scope and availability are confirmed separately. No sending engine or calendar booking system is enabled.</p><h2>No outcome guarantees</h2><p>Research fit is not buying intent. Email verification where available does not guarantee deliverability or replies. Meetings, pipeline and revenue are not guaranteed.</p><h2>Safe use</h2><p>Do not submit credentials, confidential databases or sensitive personal information. Any real engagement requires a separately agreed scope, lawful data-use responsibilities and commercial terms.</p></article>}
</div>}
</SiteLayout>
