---
import Breadcrumb from './Breadcrumb.astro';
import Button from './Button.astro';
import FAQ from './FAQ.astro';
import type { ServiceDetail } from '../data/page-details';

interface Service {
  slug: string;
  title: string;
  category: string;
  pending: boolean;
  headline: string;
  intro: string;
  deliverables: string[];
  steps: string[];
  boundary: string;
}
interface Props { service: Service; detail: ServiceDetail; services: Service[]; }
const { service, detail, services } = Astro.props;
const primaryHref = service.pending ? '/free-consultation' : '/request-sample';
const primaryLabel = service.pending ? 'Book a Consultation' : 'Request a Prospect Sample';
const related = detail.relatedSlugs.map(slug => services.find(item => item.slug === slug)).filter(item => item !== undefined);
---
<div class="service-page">
  <div class="service-grid" aria-hidden="true"></div>
  <div class="container service-container">
    <Breadcrumb items={[{ label: 'Services', href: '/services' }, { label: service.title }]} />
    <section class="service-hero" aria-labelledby="service-title">
      <div class="service-hero-copy">
        <p class="eyebrow">{service.category}</p>

        <h1 id="service-title">{service.headline}</h1>
        <p class="service-lead">{service.intro}</p>
        <div class="actions"><Button href={primaryHref}>{primaryLabel}</Button><Button href="/services" variant="secondary">Compare Services</Button></div>
      </div>
      <aside class="service-brief" aria-label={`${service.title} overview`}>
        <span class="brief-label">A useful starting point</span>
        <h2>{detail.briefTitle}</h2>
        <p>{detail.briefText}</p>
        <div class="brief-lines" aria-hidden="true"><i></i><i></i><i></i></div>
        <small>{service.pending ? 'Planning illustration · scope and availability discussed by consultation' : 'Illustrative brief · final fields follow the agreed scope'}</small>
      </aside>
    </section>

    <section class="service-section" aria-labelledby="challenges-title">
      <div class="section-intro"><p class="eyebrow">WHO THIS HELPS</p><h2 id="challenges-title">{detail.problemTitle}</h2><p>{detail.audience}</p></div>
      <div class="service-card-grid">{detail.problems.map((item, index) => <article class="service-card"><span>0{index + 1}</span><p>{item}</p></article>)}</div>
    </section>

    <section class="service-band" aria-labelledby="includes-title">
      <div><p class="eyebrow">SCOPE AND DELIVERABLES</p><h2 id="includes-title">What the engagement can include.</h2><p>{detail.scopeIntro}</p><p class="service-boundary">{service.boundary}</p></div>
      <div class="deliverable-list">{service.deliverables.map((item, index) => <article><span aria-hidden="true">{index + 1}</span><div><h3>{detail.deliverableTitles[index]}</h3><p>{item}</p></div></article>)}</div>
    </section>

    <section class="service-section split-service" aria-labelledby="benefits-title">
      <div class="service-visual" aria-label={`Illustrative ${service.title} workflow`}><div class="visual-head"><strong>ISLAH</strong><span>WORKFLOW</span></div>{detail.visualSteps.map((item, index) => <div class="visual-row"><i>{index + 1}</i><span>{item}</span><b>{index === detail.visualSteps.length - 1 ? 'Ready' : 'Review'}</b></div>)}<small>Process illustration · not a performance report</small></div>
      <div><p class="eyebrow">PRACTICAL VALUE</p><h2 id="benefits-title">What your team receives from a clearer process.</h2><div class="benefit-list">{detail.benefits.map(item => <p><span aria-hidden="true">✓</span>{item}</p>)}</div></div>
    </section>

    <section class="service-section process-block" aria-labelledby="process-title">
      <div class="section-intro"><p class="eyebrow">HOW IT WORKS</p><h2 id="process-title">A reviewable path from brief to handoff.</h2><p>{detail.clientInput}</p></div>
      <div class="service-process">{service.steps.map((step, index) => <article><span>{index + 1}</span><h3>{detail.stepTitles[index]}</h3><p>{step}</p></article>)}</div>
    </section>

    <section class="service-section" aria-labelledby="use-cases-title">
      <div class="section-intro"><p class="eyebrow">WHERE IT FITS</p><h2 id="use-cases-title">Practical use cases for B2B teams.</h2></div>
      <div class="use-case-grid">{detail.useCases.map(item => <article><span aria-hidden="true">↗</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
    </section>

    <section class="service-section faq-layout" aria-labelledby="faq-title"><div><p class="eyebrow">COMMON QUESTIONS</p><h2 id="faq-title">What to know before you enquire.</h2><p>Scope, responsibilities and limitations should be clear before any work begins.</p></div><FAQ items={detail.faqs} /></section>

    <section class="service-section related-services" aria-labelledby="related-title"><div class="section-intro"><p class="eyebrow">RELATED SERVICES</p><h2 id="related-title">Choose the next service by your starting point.</h2></div><div class="related-grid">{related.map(item => <a href={`/${item.slug}`}><span>{item.category}</span><h3>{item.title}</h3><p>{item.pending ? 'Explore managed service scope and current availability.' : 'Explore a standalone research and data service.'}</p><b>View service ↗</b></a>)}</div></section>

    <section class="service-final"><div><p class="eyebrow">A MORE FOCUSED NEXT STEP</p><h2>{detail.ctaTitle}</h2><p>{detail.ctaText}</p></div><div class="actions"><Button href={primaryHref}>{primaryLabel}</Button><Button href="/contact" variant="secondary">Ask a Question</Button></div></section>
  </div>
</div>

<style>
  .service-page { position: relative; overflow: hidden; background: #fff; }
  .service-grid { position: absolute; inset: 0 0 auto; height: 720px; pointer-events: none; background-image: linear-gradient(#e8ebe7 1px,transparent 1px),linear-gradient(90deg,#e8ebe7 1px,transparent 1px); background-size: 48px 48px; opacity: .58; mask-image: linear-gradient(#000 55%,transparent); }
  .service-container { position: relative; }
  .service-hero { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(330px,.75fr); gap: 70px; align-items: center; padding: 66px 0 104px; }
  .service-hero-copy { max-width: 780px; }
  .service-hero h1 { font-size: clamp(48px,5.5vw,76px); }
  .service-lead { max-width: 670px; font-size: 17px; }

  .service-brief { padding: 28px; border: 1px solid #dfe2df; border-radius: 18px; background: #fff; box-shadow: 0 24px 54px -30px #1118; transform: rotate(1deg); }
  .brief-label { color: #a72b09; font-size: 10px; font-weight: 750; letter-spacing: .1em; }
  .service-brief h2 { margin: 24px 0 14px; font-size: 29px; }
  .service-brief p { font-size: 13px; }
  .service-brief small { color: #777; font-size: 9px; }
  .brief-lines { display: grid; gap: 10px; margin: 24px 0; }
  .brief-lines i { height: 8px; border-radius: 8px; background: #eee; }
  .brief-lines i:nth-child(1) { width: 88%; background: #ff4d1c; }.brief-lines i:nth-child(2) { width: 68%; }.brief-lines i:nth-child(3) { width: 78%; background: #ffd1c2; }
  .service-section { padding: 88px 0; }
  .section-intro { max-width: 760px; margin-bottom: 44px; }.section-intro h2 { font-size: clamp(34px,4vw,52px); }.section-intro>p:last-child { max-width: 620px; }
  .service-card-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
  .service-card { min-height: 190px; padding: 28px; border: 1px solid #dfe2df; border-radius: 14px; background: #f8f9f8; }
  .service-card span { display: grid; place-items: center; width: 38px; height: 38px; margin-bottom: 34px; border-radius: 9px; color: #111; background: #ff4d1c; font-size: 11px; font-weight: 750; }.service-card p { margin: 0; color: #222; font-size: 15px; line-height: 1.65; }
  .service-band { display: grid; grid-template-columns: .9fr 1.1fr; gap: 74px; padding: 64px; border: 1px solid #dfe2df; border-radius: 20px; background: #f8f9f8; box-shadow: 0 14px 34px #1110008; }.service-band h2 { font-size: clamp(34px,4vw,52px); }.service-band>div>p:not(.eyebrow) { font-size: 14px; }
  .service-boundary { padding: 16px; border-left: 3px solid #ff4d1c; background: #fff; }
  .deliverable-list { display: grid; gap: 12px; }.deliverable-list article { display: grid; grid-template-columns: 38px 1fr; gap: 16px; padding: 20px; border: 1px solid #e2e2e2; border-radius: 12px; background: #fff; }.deliverable-list article>span { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #ff4d1c; font-size: 11px; font-weight: 750; }.deliverable-list h3 { margin-bottom: 5px; font-size: 17px; }.deliverable-list p { margin: 0; font-size: 12px; }
  .split-service { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }.split-service h2 { font-size: clamp(34px,4vw,52px); }
  .service-visual { padding: 26px; border: 1px solid #dfe2df; border-radius: 16px; background: #f8f9f8; box-shadow: 0 22px 48px -28px #1117; }.visual-head { display: flex; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid #ddd; font-size: 10px; }.visual-head span { color: #777; }.visual-row { display: grid; grid-template-columns: 30px 1fr auto; gap: 14px; align-items: center; margin-top: 14px; padding: 15px; border: 1px solid #e3e3e3; border-radius: 9px; background: #fff; font-size: 12px; }.visual-row i { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #ff4d1c; font-style: normal; font-weight: 700; }.visual-row b { color: #777; font-size: 9px; }.service-visual small { display: block; margin-top: 16px; color: #777; font-size: 9px; }
  .benefit-list p { display: flex; gap: 13px; padding: 16px 0; margin: 0; border-bottom: 1px solid #e5e5e5; color: #333; font-size: 14px; }.benefit-list span { color: #a72b09; font-weight: 800; }
  .process-block { border-top: 1px solid #e5e5e5; }.service-process { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }.service-process article { padding: 28px; border: 1px solid #dfe2df; border-radius: 14px; }.service-process article>span { color: #a72b09; font-size: 11px; font-weight: 750; }.service-process h3 { margin-top: 34px; font-size: 20px; }.service-process p { margin: 0; font-size: 13px; }
  .use-case-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }.use-case-grid article { padding: 28px; border: 1px solid #e0e2e0; border-radius: 14px; background: #f8f9f8; }.use-case-grid article>span { color: #a72b09; font-size: 22px; }.use-case-grid h3 { margin-top: 34px; font-size: 19px; }.use-case-grid p { margin: 0; font-size: 13px; }
  .faq-layout { display: grid; grid-template-columns: .7fr 1.3fr; gap: 80px; border-top: 1px solid #e5e5e5; }.faq-layout h2 { font-size: clamp(34px,4vw,50px); }.faq-layout :global(.faq details) { padding: 25px 0; }
  .related-services { border-top: 1px solid #e5e5e5; }.related-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }.related-grid a { display: block; padding: 25px; border: 1px solid #dfe2df; border-radius: 14px; text-decoration: none; }.related-grid a:hover { box-shadow: 0 14px 30px #1111; transform: translateY(-2px); }.related-grid span { color: #a72b09; font-size: 9px; font-weight: 750; text-transform: uppercase; }.related-grid h3 { margin-top: 30px; font-size: 19px; }.related-grid p { font-size: 12px; }.related-grid b { font-size: 11px; }
  .service-final { display: grid; grid-template-columns: 1.2fr .8fr; gap: 60px; align-items: center; margin-bottom: 90px; padding: 54px; border: 1px solid #e0e2e0; border-radius: 20px; background: #f8f9f8; background-image: radial-gradient(circle at 88% 50%,#ff4d1c20,transparent 24%); }.service-final h2 { font-size: clamp(34px,4vw,50px); }.service-final p { max-width: 680px; }.service-final .actions { justify-content: flex-end; }
  @media (max-width: 900px) { .service-hero { grid-template-columns: 1fr; gap: 36px; }.service-brief { max-width: 620px; transform: none; }.service-band,.split-service,.faq-layout { grid-template-columns: 1fr; gap: 44px; }.service-card-grid,.service-process,.use-case-grid,.related-grid { grid-template-columns: repeat(2,1fr); }.service-final { grid-template-columns: 1fr; }.service-final .actions { justify-content: flex-start; } }
  @media (max-width: 680px) { .service-hero { padding: 44px 0 64px; }.service-hero h1 { font-size: 42px; }.service-lead { font-size: 15px; }.service-brief { padding: 22px; }.service-section { padding: 60px 0; }.service-card-grid,.service-process,.use-case-grid,.related-grid { grid-template-columns: 1fr; }.service-card { min-height: 0; padding: 23px; }.service-card span { margin-bottom: 22px; }.service-band { padding: 38px 22px; border-radius: 16px; }.split-service,.faq-layout { gap: 34px; }.service-process article,.use-case-grid article { padding: 23px; }.service-process h3,.use-case-grid h3 { margin-top: 22px; }.service-final { margin-bottom: 60px; padding: 38px 22px; }.service-final .actions { align-items: stretch; flex-direction: column; } }
</style>
