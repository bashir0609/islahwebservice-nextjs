---
import EditorialLayout from './EditorialLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import {renderMarkdown} from './markdown.mjs';
interface EditorialRecord {
  title: string; slug: string; markdown: string; excerpt?: string; author?: string; attribution?: string;
  publishedAt?: string; image?: {source?: string; alt?: string; caption?: string; attribution?: string};
  results?: string[];
  seo: {title?: string; description?: string; canonicalUrl?: string; socialImage?: {source?: string}};
}
interface Props { record: EditorialRecord | null; collection: 'blog' | 'portfolio'; unavailable?: boolean; }
const {record, collection, unavailable = false} = Astro.props;
const label = collection === 'blog' ? 'Blog' : 'Portfolio';
const title = record?.seo.title ?? record?.title ?? (unavailable ? 'Content temporarily unavailable' : 'Page not found');
const description = record?.seo.description ?? record?.excerpt ?? '';
---
<EditorialLayout title={title} description={description} canonicalUrl={record?.seo.canonicalUrl} socialImage={record?.seo.socialImage?.source ?? record?.image?.source} publishedAt={record?.publishedAt}>
  <div class="container">
    <Breadcrumb items={[{label, href: `/${collection}`}, {label: record?.title ?? title}]} />
    {record ? <article class="section compact">
      <header class="page-hero">
        <p class="eyebrow">{label}</p><h1>{record.title}</h1>
        {record.excerpt && <p>{record.excerpt}</p>}
        {record.author && <p>{record.author}</p>}
        {record.publishedAt && <p><time datetime={record.publishedAt}>{record.publishedAt}</time></p>}
      </header>
      {record.image?.source && <figure><img src={record.image.source} alt={record.image.alt ?? (collection === 'portfolio' ? record.title : '')} loading="lazy" decoding="async" />{record.image.caption && <figcaption>{record.image.caption}</figcaption>}{record.image.attribution && <p>{record.image.attribution}</p>}</figure>}
      {collection === 'portfolio' && record.results?.length && <section class="published-summary" aria-labelledby="published-summary-title"><p class="eyebrow">PUBLISHED PROJECT SUMMARY</p><h2 id="published-summary-title">Recorded deliverable details</h2><ul>{record.results.map(result => <li>{result}</li>)}</ul><p>These details are preserved from the existing public case study; they are not generalized performance guarantees.</p></section>}
      <div class="editorial-body" set:html={renderMarkdown(record.markdown)} />
      {collection === 'blog' && <aside class="article-next-step"><p class="eyebrow">TURN THE GUIDANCE INTO A CLEAR BRIEF</p><h2>Need the research behind your next outreach project?</h2><p>Request a criteria-led prospect sample, or explore the difference between building a new account list and enriching records you already have.</p><div class="actions"><a class="button primary" href="/request-sample">Request a Prospect Sample</a><a class="button secondary" href="/services">Compare Services</a></div></aside>}
      {record.attribution && <p>{record.attribution}</p>}
    </article> : <section class="page-hero"><h1>{title}</h1><p>{unavailable ? 'Please try again later.' : 'This published page could not be found.'}</p><a class="text-link" href={`/${collection}`}>Return to {label}</a></section>}
  </div>
</EditorialLayout>
<style>
  .editorial-body { max-width: 75ch; overflow-wrap: anywhere; }
  .editorial-body :global(p), .editorial-body :global(ul), .editorial-body :global(ol), .editorial-body :global(blockquote) { margin-block: 1.25rem; }
  .editorial-body :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .editorial-body :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .editorial-body :global(h2), .editorial-body :global(h3) { margin-top: 2rem; }
  .editorial-body :global(pre) { overflow-x: auto; padding: 1rem; }
  img, .editorial-body :global(img) { max-width: 100%; height: auto; }
  .article-next-step, .published-summary { max-width: 75ch; margin-block: 2rem; padding: 2rem; border: 1px solid var(--line); border-radius: 18px; background: #fff8f3; }
  .published-summary ul { padding-left: 1.25rem; color: #555; line-height: 1.8; }
  .published-summary p:last-child { margin-bottom: 0; font-size: 12px; }
</style>
