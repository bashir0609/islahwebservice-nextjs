{
  "name": "islah-web-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint .",
    "qa:build": "node scripts/check-build.mjs",
    "qa:browser": "node scripts/browser-check.mjs",
    "content:snapshot": "node scripts/generate-offline-content.mjs",
    "prebuild": "npm run content:snapshot",
    "build": "astro build",
    "test": "node --import tsx --test tests/*.test.*",
    "test:postgres": "node --test tests/postgres-worker.integration.test.mjs",
    "content:check": "node scripts/content-export.mjs",
    "content:report": "node scripts/migration-report.mjs",
    "content:reconcile": "node scripts/content-db-export.mjs",
    "content:metadata-export": "node scripts/editorial-metadata-export.mjs",
    "urls:classify": "node scripts/classify-urls.mjs",
    "sanity:plan": "node scripts/sanity-import-plan.mjs --write"
  },
  "dependencies": {
    "@astrojs/react": "7.1.4",
    "@astrojs/vercel": "11.0.20",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "pg": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "1.7.0",
    "htmlparser2": "8.0.2",
    "oxc-transform-react": "^0.145.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@vitejs/plugin-react": "6.1.0"
  }
}
